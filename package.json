{
  "name": "stargate-repo-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared repository preview, verification, browser-test and image tooling. Flagship build dependencies remain independent.",
  "scripts": {
    "preview": "node scripts/preview.js",
    "verify": "node scripts/verify.js",
    "test:pilots": "node scripts/run-pilot-suites.js",
    "test:preview": "node --test --test-isolation=none scripts/test-preview.js scripts/test-preview-handlers.js scripts/test-preview-api.js scripts/test-verification.js",
    "test:preview:handlers": "node --test --test-isolation=none scripts/test-preview-handlers.js",
    "gallery:generate": "node hub/generate.js",
    "gallery:check": "node hub/generate.js --check",
    "security:hub": "node scripts/audit-hub-security.js",
    "security:hub:strict": "node scripts/audit-hub-security.js --strict",
    "security:deps": "npm audit --include=dev --include=optional --include=peer",
    "security:deps:featured": "npm --prefix Stargate_OG audit",
    "test:pages-output-guard": "node scripts/test-build-pages-output-guard.js",
    "test:pages-release": "node scripts/audit-pages-release.js",
    "test:suites": "node scripts/run-qualified-suites.js"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "puppeteer": "^25.16.0",
    "puppeteer-core": "^25.16.0",
    "pngjs": "^7.0.0"
  }
}
